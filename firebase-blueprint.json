{
  "entities": {
    "User": {
      "title": "User",
      "description": "Agent or Brokerage Admin profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "brokerageName": { "type": "string" },
        "role": { "type": "string", "enum": ["AGENT", "ADMIN"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "name", "role", "createdAt", "updatedAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Real estate property listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "postalCode": { "type": "string" },
        "price": { "type": "number" },
        "beds": { "type": "number" },
        "baths": { "type": "number" },
        "sqft": { "type": "number" },
        "mlsNumber": { "type": "string" },
        "originatingSystemName": { "type": "string" },
        "country": { "type": "string" },
        "brokerageName": { "type": "string" },
        "agentName": { "type": "string" },
        "description": { "type": "string" },
        "images": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "name": { "type": "string" }
            }
          } 
        },
        "talkingPoints": { "type": "array", "items": { "type": "string" } },
        "webhookUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ownerId", "address", "createdAt", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A captured lead interested in a property",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Agent profiles"
    },
    "listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Real estate property listings"
    },
    "listings/{listingId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Leads generated for a specific listing"
    }
  }
}
