{
  "entities": {
    "User": {
      "title": "User",
      "description": "Agent or Brokerage Admin profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "brokerage": { "type": "string" },
        "role": { "type": "string", "enum": ["AGENT", "ADMIN"] },
        "defaultVoiceId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email", "name", "role", "createdAt", "updatedAt"]
    },
    "Voice": {
      "title": "Voice",
      "description": "AI Voice model",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Processing"] },
        "type": { "type": "string", "enum": ["Cloned", "Synthetic"] },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "status", "type"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Invitation to join a brokerage",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "brokerage": { "type": "string" },
        "inviterId": { "type": "string" },
        "inviterName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "email", "brokerage", "status"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Real estate property listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "postalCode": { "type": "string" },
        "price": { "type": "number" },
        "tourDescriptors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of up to 16 features or rooms visitors can ask about"
        },
        "beds": { "type": "number" },
        "baths": { "type": "number" },
        "sqft": { "type": "number" },
        "mlsNumber": { "type": "string" },
        "originatingSystemName": { "type": "string" },
        "country": { "type": "string" },
        "brokerageName": { "type": "string" },
        "agentName": { "type": "string" },
        "description": { "type": "string" },
        "images": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "name": { "type": "string" }
            }
          } 
        },
        "talkingPoints": { "type": "array", "items": { "type": "string" } },
        "webhookUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["ownerId", "address", "createdAt", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A captured lead interested in a property",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A transcript of an AI-agent tour call",
      "type": "object",
      "properties": {
        "property": { "type": "string" },
        "lang": { "type": "string" },
        "duration": { "type": "string" },
        "qs": { "type": "number" },
        "date": { "type": "number" },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "speaker": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      },
      "required": ["property", "lang", "date", "transcript"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "allowRegistrations": { "type": "boolean" },
        "pricingTitle": { "type": "string" },
        "pricingDescription": { "type": "string" },
        "plans": { "type": "array" },
        "brokerageName": { "type": "string" },
        "brokerageAddress": { "type": "string" },
        "brokerageCity": { "type": "string" },
        "brokerageProvince": { "type": "string" },
        "brokerageCountry": { "type": "string" },
        "brokeragePostalCode": { "type": "string" },
        "brokeragePhone": { "type": "string" },
        "brokerageEmail": { "type": "string" },
        "adminEmail": { "type": "string" },
        "socials": {
          "type": "object",
          "properties": {
            "facebook": { "type": "string" },
            "instagram": { "type": "string" },
            "youtube": { "type": "string" },
            "tiktok": { "type": "string" },
            "x": { "type": "string" },
            "linkedin": { "type": "string" }
          }
        },
        "stripeConnected": { "type": "boolean" },
        "webhookSecret": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["maintenanceMode"]
    },
    "LaunchNotification": {
      "title": "Launch Notification",
      "description": "Notification signup from the landing page",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "referrals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "object" },
        "source": { "type": "string" }
      },
      "required": ["fullName", "email", "createdAt"]
    }
  },
  "firestore": {
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Global application configuration"
    },
    "launch_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/LaunchNotification" },
      "description": "Signups from the landing page"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Agent profiles"
    },
    "users/{userId}/voices/{voiceId}": {
      "schema": { "$ref": "#/entities/Voice" },
      "description": "Custom voice models for the agent"
    },
    "invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Team invitations"
    },
    "listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Real estate property listings"
    },
    "listings/{listingId}/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Leads generated for a specific listing"
    },
    "conversations/{convoId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversation transcripts and call analytics"
    }
  }
}
