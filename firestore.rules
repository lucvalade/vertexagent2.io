rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } // Relaxed verification for this environment
    function isDev() { return true; } // Safety bypass for testing
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN"; }

    // User validation
    function isValidUser(data) {
      let isBaseValid = data.keys().hasAll(['email', 'name', 'role', 'createdAt', 'updatedAt']) 
        && data.email is string && data.email.size() <= 100
        && data.name is string && data.name.size() <= 100
        && data.role is string && (data.role == 'AGENT' || data.role == 'ADMIN')
        && data.createdAt is number
        && data.updatedAt is number;
      
      let hasValidBrokerage = !data.keys().hasAny(['brokerage']) || (data.brokerage is string && data.brokerage.size() <= 100);
      let hasValidProfile = !data.keys().hasAny(['brokerageProfile']) || data.brokerageProfile is map;
      let hasValidBranding = !data.keys().hasAny(['branding']) || data.branding is map;
      let hasValidCompliance = !data.keys().hasAny(['compliance']) || data.compliance is map;
      let hasValidNotifications = !data.keys().hasAny(['notifications']) || data.notifications is map;
      
      return isBaseValid && hasValidBrokerage && hasValidProfile && hasValidBranding && hasValidCompliance && hasValidNotifications;
    }

    // Listing validation
    function isValidListing(data) {
      let isBaseValid = data.keys().hasAll(['ownerId', 'address', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.address is string
        && data.createdAt is number
        && data.updatedAt is number;
      
      return isBaseValid; 
    }

    // Lead validation
    function isValidLead(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.createdAt is number
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 20))
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100))
        && (!data.keys().hasAny(['message']) || (data.message is string && data.message.size() <= 1000));
    }

    // Conversation validation
    function isValidConversation(data) {
      return data.keys().hasAll(['property', 'lang', 'date', 'transcript'])
        && data.property is string
        && data.lang is string
        && data.date is number
        && data.transcript is list;
    }

    match /users/{userId} {
      allow get: if true; 
      allow list: if isSignedIn(); 
      allow create: if isVerified() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && isValidUser(incoming());
      allow update: if isVerified() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && (incoming().role == existing().role || request.auth.token.email == "luc.valade@gmail.com")
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'brokerage', 'updatedAt', 'brokerageProfile', 'branding', 'compliance', 'notifications', 'role', 'defaultVoiceId']);
      allow delete: if false;

      match /voices/{voiceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /invitations/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (incoming().status == "accepted" || isAdmin());
      allow delete: if isAdmin();
    }

    match /settings/global {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == "luc.valade@gmail.com");
    }

    match /listings/{listingId} {
      allow get: if true;
      allow list: if isVerified();
      
      allow create: if isVerified()
        && isValidListing(incoming());
        
      allow update: if isVerified()
        && isValidListing(incoming())
        && incoming().ownerId == existing().ownerId;
        
      allow delete: if isSignedIn();
        
      match /leads/{leadId} {
        allow get: if isSignedIn() 
          && isValidId(listingId)
          && isValidId(leadId)
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid;
        
        allow list: if isSignedIn() 
          && isValidId(listingId)
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid;

        allow create: if isValidId(listingId)
          && isValidId(leadId)
          && isValidLead(incoming())
          && exists(/databases/$(database)/documents/listings/$(listingId));
          
        allow update, delete: if false;
      }
    }

    match /conversations/{convoId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidConversation(incoming());
      allow delete: if isAdmin();
    }
  }
}
